# Environment variables for GetSwydd API
HOST=127.0.0.1
PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
# Public employer feeds for the India catalog. Customize this JSON map as needed.
GETSWYDD_GREENHOUSE_BOARDS='{"razorpaysoftwareprivatelimited":"Razorpay","hackerrank":"HackerRank","enterpret":"Enterpret","instawork":"Instawork"}'
GETSWYDD_LEVER_BOARDS={}
GETSWYDD_ASHBY_BOARDS={}
# 0 disables scheduled refresh. Use 5–1440 minutes to enable it.
GETSWYDD_SEARCH_INTERVAL_MINUTES=0
# Optional. The API calls OpenAI only on an explicit semantic analysis request.
GETSWYDD_OPENAI_API_KEY=
# Select one provider for discovery. Groq uses GROQ_API_KEY.
GETSWYDD_DISCOVERY_PROVIDER=openai
GROQ_API_KEY=
# For OpenAI discovery, use a separate key or the OpenAI key above.
GETSWYDD_AGENT_OPENAI_API_KEY=
# Leave blank for the provider default: gpt-4.1-mini (OpenAI) or openai/gpt-oss-20b (Groq).
GETSWYDD_DISCOVERY_MODEL=
