# GetSwydd .gitignore

# Dependencies
node_modules/
.pnp
.pnp.js

# Testing and coverage
coverage/
.nyc_output/
.pytest_cache/

# Production and build outputs
.next/
out/
build/
dist/

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# Environment variables & secrets
.env
.env*.local
!.env.example
*.pem
*.key
*.cert
*.crt

# Local databases
*.sqlite
*.sqlite3
*.db
*.db-journal

# Resumes and user uploaded files
uploads/
resumes/
!/frontend/src/app/resumes/
*.pdf
*.docx
!docs/**/*.pdf
!docs/**/*.docx

# IDEs and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Temporary and log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.turbo/
